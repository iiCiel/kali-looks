// kali-looks: your desktop's everyday rights, while Chrome Remote Desktop runs.
//
// Plasma runs its parts (taskbar, network icon, Turn Off, brightness, power modes...)
// from your systemd user service, and the system judges those by your user's "display
// session". With Chrome Remote Desktop's background desktop started first, that's
// Remote Desktop's (no seat), so they counted as "not at the computer": the network
// icon and Turn Off asked for an admin password, the brightness keys did nothing,
// power modes, the lid and sleep inhibitors were refused.
//
// While you're logged in at the laptop (an active session on seat0), your desktop
// gets exactly what someone at the laptop gets: each action's own "active" default
// (no password, your password, or the admin's), asked of the action itself through
// kali-looks-at-laptop. Nothing more. When you're only connected remotely (or the helper
// is missing), just the everyday few in the short list below.
// Remove with:
//   looks desktop-rights remove
polkit.addRule(function (action, subject) {
  if (subject.user != "@USER@" || !subject.active || subject.local)
    return polkit.Result.NOT_HANDLED;
  var id = action.id;
  var answer = "";
  try {
    answer = polkit.spawn(["/usr/local/libexec/kali-looks-at-laptop", subject.user, id]).trim();
  } catch (e) {
    answer = "";
  }
  var results = {
    "yes": polkit.Result.YES,
    "auth_self": polkit.Result.AUTH_SELF,
    "auth_self_keep": polkit.Result.AUTH_SELF_KEEP,
    "auth_admin": polkit.Result.AUTH_ADMIN,
    "auth_admin_keep": polkit.Result.AUTH_ADMIN_KEEP
  };
  if (results[answer] !== undefined)
    return results[answer];
  // not at the laptop (Remote Desktop only), or the helper is missing: the everyday few,
  // as before
  var allowed =
    // turn off, restart, sleep (also while Remote Desktop's session counts as another user)
    /^org\.freedesktop\.login1\.(power-off|reboot|halt|suspend|hibernate)(-multiple-sessions)?$/.test(id) ||
    // network and Wi-Fi from the taskbar
    /^org\.freedesktop\.NetworkManager\.(network-control|enable-disable-(network|wifi|wwan)|wifi\.scan|settings\.modify\.own|wifi\.share\.(open|protected))$/.test(id) ||
    // USB drives
    /^org\.freedesktop\.udisks2\.(filesystem-mount|encrypted-unlock|eject-media|power-off-drive)$/.test(id) ||
    // screen brightness (the brightness keys and slider)
    /^org\.kde\.powerdevil\.backlighthelper\.(brightness|brightnessmax|setbrightness|syspath)$/.test(id);
  return allowed ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
});
