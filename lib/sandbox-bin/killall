#!/bin/bash
# killall stand-in for kali-looks' hidden sessions: only this display's processes.
if [[ $EUID -eq 0 && -n ${SUDO_USER:-} ]]; then exec runuser -u "$SUDO_USER" -- "$0" "$@"; fi
is_sig() { [[ $1 =~ ^[0-9]+$ ]] || kill -l "${1#SIG}" >/dev/null 2>&1; }
sig=TERM; names=(); wait=0; icase=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -s|--signal) sig=$2; shift ;;
    --signal=*) sig=${1#*=} ;;
    -w|--wait) wait=1 ;;
    -I|--ignore-case) icase=-i ;;
    -q|--quiet|-e|--exact|-v|--verbose|-g|--process-group|-i|--interactive|-r|--regexp) ;;
    -u|--user|-o|--older-than|-y|--younger-than|-n|--ns|-Z|--context) shift ;;
    -?*) if [[ $1 != --* ]] && is_sig "${1#-}"; then sig=${1#-}; fi ;;
    *) names+=("$1") ;;
  esac
  shift
done
rc=1; all=()
for n in "${names[@]}"; do
  # process names are cut to 15 characters
  pids=$("$(dirname "$0")/pgrep" $icase -x "${n:0:15}") || continue
  # shellcheck disable=SC2086
  kill -s "$sig" $pids && rc=0
  all+=($pids)
done
if [[ $wait == 1 ]]; then
  for i in $(seq 120); do
    alive=0; for p in "${all[@]}"; do [[ -e /proc/$p ]] && alive=1; done
    [[ $alive == 0 ]] && break; sleep 0.25
  done
fi
exit $rc
