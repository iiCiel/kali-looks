/* cupertino-xfce: Launchpad-style full-screen app grid.
   Keep one property per line: rofi 2.0 mis-parses several quoted values on one line. */
configuration {
  modi: "drun";
  show-icons: true;
  icon-theme: "{{ICON_THEME}}";
  font: "Inter 11";
  display-drun: "";
  drun-display-format: "{name}";
  matching: "fuzzy";
}
* {
  background-color: transparent;
  text-color: #ffffff;
}
window {
  transparency: "real";
  fullscreen: true;
  background-color: rgba(22, 20, 40, 90%);
  padding: 6% 12%;
}
mainbox {
  spacing: 40px;
  children: [ searchrow, listview ];
}
searchrow {
  orientation: horizontal;
  expand: false;
  children: [ padl, inputbar, padr ];
}
padl {
  expand: true;
}
padr {
  expand: true;
}
inputbar {
  expand: false;
  padding: 6px 12px;
  border-radius: 9px;
  background-color: rgba(255, 255, 255, 16%);
  children: [ entry ];
}
entry {
  placeholder: "Search";
  placeholder-color: rgba(255, 255, 255, 60%);
  horizontal-align: 0.5;
  width: 220px;
}
listview {
  columns: 7;
  lines: 4;
  spacing: 30px;
  flow: horizontal;
  fixed-columns: true;
  scrollbar: false;
}
element {
  orientation: vertical;
  padding: 10px;
  spacing: 8px;
  border-radius: 14px;
}
element selected {
  background-color: rgba(255, 255, 255, 16%);
}
element-icon {
  size: 84px;
  horizontal-align: 0.5;
}
element-text {
  horizontal-align: 0.5;
  vertical-align: 0.5;
}
