# cupertino-xfce: macOS-style frosted dock for Plank Reloaded (Cupertino-Light)
[PlankTheme]
TopRoundness=16
BottomRoundness=16
LineWidth=1
OuterStrokeColor=255;;255;;255;;190
FillStartColor=250;;250;;252;;206
FillEndColor=242;;242;;246;;200
InnerStrokeColor=0;;0;;0;;16

[PlankDockTheme]
HorizPadding=1.4
TopPadding=1.1
BottomPadding=2.1
ItemPadding=1.7
SeparatorPadding=-1
IndicatorColor=40;;40;;45;;220
IndicatorSize=1.1
IndicatorStyle=2
IconShadowSize=0.4
UrgentBounceHeight=1.2
LaunchBounceHeight=0.8
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=0
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=255;;59;;48;;255
BadgeStyle=0
BadgeTextColor=255;;255;;255;;255
ActiveItemStyle=3
ActiveItemColor=0;;0;;0;;0
