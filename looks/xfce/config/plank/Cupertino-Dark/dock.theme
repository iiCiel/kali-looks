# cupertino-xfce: macOS-style frosted dock for Plank Reloaded (Cupertino-Dark)
[PlankTheme]
TopRoundness=18
BottomRoundness=18
LineWidth=1
OuterStrokeColor=255;;255;;255;;45
FillStartColor=52;;52;;60;;190
FillEndColor=36;;36;;44;;190
InnerStrokeColor=255;;255;;255;;18

[PlankDockTheme]
HorizPadding=5
TopPadding=5
BottomPadding=9
ItemPadding=4
SeparatorPadding=-1
IndicatorColor=245;;245;;247;;230
IndicatorSize=1.2
IndicatorStyle=2
IconShadowSize=0.6
UrgentBounceHeight=1.2
LaunchBounceHeight=0.8
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=0
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=255;;59;;48;;255
BadgeStyle=0
BadgeTextColor=255;;255;;255;;255
ActiveItemStyle=3
ActiveItemColor=0;;0;;0;;0
