# cupertino-xfce boot splash: black background, a thin rounded progress bar, and a
# password field for encrypted disks. No logo.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ---- progress bar --------------------------------------------------------------------
box.image = Image("progress_box.png");
box.sprite = Sprite(box.image);
box.x = screen_x + screen_w / 2 - box.image.GetWidth() / 2;
box.y = screen_y + screen_h * 0.62;
box.sprite.SetPosition(box.x, box.y, 1);

bar.original = Image("progress_bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(box.x, box.y, 2);
bar.width = 0;

fun progress_callback(duration, progress) {
  new_width = Math.Int(bar.original.GetWidth() * progress);
  if (new_width < 6) new_width = 6;
  if (new_width != bar.width) {
    bar.width = new_width;
    bar.image = bar.original.Scale(new_width, bar.original.GetHeight());
    bar.sprite.SetImage(bar.image);
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- password prompt (disk encryption) -------------------------------------------------
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = screen_x + screen_w / 2 - entry.image.GetWidth() / 2;
entry.y = box.y - 70;
entry.sprite.SetPosition(entry.x, entry.y, 3);
entry.sprite.SetOpacity(0);

prompt.sprite = Sprite();
prompt.sprite.SetOpacity(0);
dot.image = Image("dot.png");
max_dots = 24;

# Bullets are images, not text, so they work even without a text renderer. They're
# created once here: sprites made inside a function are local and would vanish.
for (i = 0; i < max_dots; i++) {
  bullet[i].sprite = Sprite(dot.image);
  bullet[i].sprite.SetPosition(entry.x + 14 + i * (dot.image.GetWidth() + 5),
                               entry.y + entry.image.GetHeight() / 2 - dot.image.GetHeight() / 2, 5);
  bullet[i].sprite.SetOpacity(0);
}

fun show_dots(count) {
  for (i = 0; i < max_dots; i++) {
    if (i < count) bullet[i].sprite.SetOpacity(1);
    else bullet[i].sprite.SetOpacity(0);
  }
}

fun display_password_callback(prompt_text, bullet_count) {
  if (prompt_text == "") prompt_text = "Password";
  prompt.image = Image.Text(prompt_text, 1, 1, 1, 1, "Sans 12");
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetPosition(screen_x + screen_w / 2 - prompt.image.GetWidth() / 2, entry.y - 30, 4);
  prompt.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
  show_dots(bullet_count);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

answer.sprite = Sprite();
fun display_question_callback(prompt_text, entry_text) {
  display_password_callback(prompt_text, 0);
  answer.image = Image.Text(entry_text + " ", 1, 1, 1, 1, "Sans 14");
  answer.sprite.SetImage(answer.image);
  answer.sprite.SetPosition(entry.x + 14, entry.y + entry.image.GetHeight() / 2 - answer.image.GetHeight() / 2, 5);
  answer.sprite.SetOpacity(1);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
  prompt.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  answer.sprite.SetOpacity(0);
  show_dots(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---- messages (e.g. "Checking disks") ---------------------------------------------------
message.sprite = Sprite();
fun message_callback(text) {
  message.image = Image.Text(text, 0.75, 0.75, 0.75, 1, "Sans 10");
  message.sprite.SetImage(message.image);
  message.sprite.SetPosition(screen_x + screen_w / 2 - message.image.GetWidth() / 2, box.y + 40, 6);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
  bar.image = bar.original;
  bar.sprite.SetImage(bar.image);
}
Plymouth.SetQuitFunction(quit_callback);
