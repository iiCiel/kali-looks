/* cupertino-xfce: macOS-style notifications (xfce4-notifyd theme "Cupertino-Notify").
   picom blurs and rounds the window; this sets the frosted fill and text. */
#XfceNotifyWindow {
  background-color: {{NOTIFY_BG}};
  color: {{NOTIFY_FG}};
  border: 1px solid {{NOTIFY_BORDER}};
  border-radius: 14px;
  padding: 4px;
}
#XfceNotifyWindow:hover {
  background-color: {{NOTIFY_HOVER}};
}
#XfceNotifyWindow label#summary {
  font-family: Inter, sans-serif;
  font-weight: 600;
  color: {{NOTIFY_FG}};
}
#XfceNotifyWindow label#body {
  font-family: Inter, sans-serif;
  color: {{NOTIFY_BODY}};
}
#XfceNotifyWindow button {
  border-radius: 8px;
  background-image: none;
  box-shadow: none;
}
#XfceNotifyWindow progressbar trough {
  border-radius: 4px;
  min-height: 6px;
}
#XfceNotifyWindow progressbar progress {
  border-radius: 4px;
  min-height: 6px;
  background-color: #0a84ff;
}
