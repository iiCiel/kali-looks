# ---- actions ------------------------------------------------------------------------
def run(*argv):
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        print(f"cupertino-menud: {argv[0]}: {e}", file=sys.stderr)


def user_dir(name, fallback):
    try:
        out = subprocess.run(["xdg-user-dir", name], capture_output=True, text=True, timeout=2).stdout.strip()
        if out:
            return out
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.expanduser(fallback)


def key(combo):
    def act(xid):
        cmd = ["xdotool"]
        if xid:
            cmd += ["windowactivate", "--sync", str(xid)]
        run(*cmd, "key", "--clearmodifiers", combo)
    return act


def cmd(*argv):
    return lambda xid: run(*argv)


def close_window(xid):
    if xid:
        run("wmctrl", "-ic", hex(xid))


def minimize(xid):
    if xid:
        run("xdotool", "windowminimize", str(xid))


def zoom(xid):
    if xid:
        run("wmctrl", "-ir", hex(xid), "-b", "toggle,maximized_vert,maximized_horz")


def mission_control(_xid):
    theme = os.path.join(CONF_DIR, "rofi", "missioncontrol.rasi")
    run("rofi", "-show", "window", *(["-theme", theme] if os.path.exists(theme) else []))


def open_dir(path):
    return lambda _xid: run("thunar", path)


def go_dir(name, fallback):
    return lambda _xid: run("thunar", user_dir(name, fallback))


def new_folder(_xid):
    desk = user_dir("DESKTOP", "~/Desktop")
    name, n = "untitled folder", 2
    while os.path.exists(os.path.join(desk, name)):
        name, n = f"untitled folder {n}", n + 1
    try:
        os.makedirs(os.path.join(desk, name))
    except OSError as e:
        print(f"cupertino-menud: {e}", file=sys.stderr)


def toggle_appearance(_xid):
    run(shutil.which("cupertino-xfce-mode") or os.path.expanduser("~/.local/bin/cupertino-xfce-mode"), "toggle")


